      "valuePath": "averageSpO2",
      "timeFormat": "ISO_INSTANT",
      "scale": 1.0,
      "localDatePath": "calendarDate",
      "verified": true,
      "sampleRef": "docs/samples/spo2.json"
    },
    {
      "area": "WEIGHT",
      "metric": "WEIGHT",
      "path": "/weight-service/weight/range/{from}/{to}",
      "dateFormat": "yyyy-MM-dd",
      "maxRangeDays": 27,
      "itemsPath": "dailyWeightSummaries",
      "timePath": "latestWeight.timestampGMT",
      "valuePath": "latestWeight.weight",
      "timeFormat": "ISO_INSTANT",
      "scale": 0.001,
      "localDatePath": "summaryDate",
      "verified": true,
      "sampleRef": "docs/samples/weight.json"
    },
    {
      "area": "WEIGHT",
      "metric": "BODY_FAT",
      "path": "/weight-service/weight/range/{from}/{to}",
      "dateFormat": "yyyy-MM-dd",
      "maxRangeDays": 27,
      "itemsPath": "dailyWeightSummaries",
      "timePath": "latestWeight.timestampGMT",
      "valuePath": "latestWeight.bodyFat",
      "timeFormat": "ISO_INSTANT",
      "scale": 1.0,
      "localDatePath": "summaryDate",
