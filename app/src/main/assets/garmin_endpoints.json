    },
    {
      "area": "STEPS_STRESS",
      "metric": "STRESS",
      "path": "/usersummary-service/stats/stress/daily/{from}/{to}",
      "dateFormat": "yyyy-MM-dd",
      "maxRangeDays": 27,
      "itemsPath": "",
      "timePath": "calendarDate",
      "valuePath": "values.overallStressLevel",
      "timeFormat": "ISO_INSTANT",
      "scale": 1.0,
      "localDatePath": "calendarDate",
      "verified": true,
      "sampleRef": "docs/samples/stress.json"
