      "valuePath": "lastNightAvg",
      "timeFormat": "ISO_INSTANT",
      "scale": 1.0,
      "localDatePath": "calendarDate",
      "verified": true,
      "sampleRef": "docs/samples/hrv.json"
    },
    {
      "area": "BODY_BATTERY",
      "metric": "BODY_BATTERY",
      "path": "/wellness-service/wellness/bodyBattery/reports/daily?startDate={from}&endDate={to}",
      "dateFormat": "yyyy-MM-dd",
      "maxRangeDays": 27,
      "itemsPath": "",
      "timePath": "startTimestampGMT",
      "endTimePath": "endTimestampGMT",
      "valuePath": "charged",
      "timeFormat": "ISO_INSTANT",
      "scale": 1.0,
      "localDatePath": "date",
      "verified": true,
      "sampleRef": "docs/samples/bodybattery.json"
    },
    {
      "area": "HEART_RATE",
