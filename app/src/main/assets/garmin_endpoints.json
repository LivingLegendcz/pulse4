      "localDatePath": "calendarDate",
      "externalIdPath": "id",
      "verified": true,
      "sampleRef": "docs/samples/sleep.json"
    },
    {
      "area": "HRV",
      "metric": "HRV",
      "path": "/hrv-service/hrv/daily/{from}/{to}",
      "dateFormat": "yyyy-MM-dd",
