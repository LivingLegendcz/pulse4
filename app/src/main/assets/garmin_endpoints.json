{
  "baseUrl": "https://personal.connectapi.garmin.com",
  "token": {
    "url": "https://personal.connectapi.garmin.com/personalapitoken-service/personal-api/personal-api-key/token",
    "method": "POST",
    "form": {},
    "headers": {"Authorization": "ApiKey {apiKey}"},
    "accessTokenPath": "$",
    "expiresInPath": "expires_in",
    "verified": true
  },
  "endpoints": [
    {
      "area": "SLEEP",
      "metric": "SLEEP_DURATION",
      "path": "/sleep-service/sleep/dailySleep?date={from}",
      "dateFormat": "yyyy-MM-dd",
      "maxRangeDays": 1,
      "itemsPath": "$",
      "timePath": "sleepStartTimestampGMT",
      "endTimePath": "sleepEndTimestampGMT",
      "valuePath": "sleepTimeSeconds",
      "timeFormat": "EPOCH_MS",
      "scale": 1.0,
      "localDatePath": "calendarDate",
      "externalIdPath": "id",
      "verified": true,
      "sampleRef": "docs/samples/sleep.json"
    },
    {
      "area": "SLEEP",
      "metric": "SLEEP_SCORE",
      "path": "/sleep-service/sleep/dailySleep?date={from}",
      "dateFormat": "yyyy-MM-dd",
      "maxRangeDays": 1,
      "itemsPath": "$",
      "timePath": "sleepEndTimestampGMT",
      "valuePath": "sleepScores.overall.value",
      "timeFormat": "EPOCH_MS",
      "scale": 1.0,
      "localDatePath": "calendarDate",
      "externalIdPath": "id",
      "verified": true,
      "sampleRef": "docs/samples/sleep.json"
    },
    {
      "area": "SLEEP",
      "metric": "SLEEP_DEEP",
